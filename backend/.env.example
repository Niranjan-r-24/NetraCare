# Database configuration
# Primary target: PostgreSQL (e.g. local or hosted)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/netracare

# Automatic fallback if PostgreSQL is not reachable
SQLITE_FALLBACK_URL=sqlite:///./netracare.db
AUTO_FALLBACK_TO_SQLITE=true

# Clinic time override: leave empty for system real time.
# Set to '2026-11-02 10:00:00' for automated rule testing suite (rule_tests.csv).
CLINIC_TIME_OVERRIDE=

# Data pack directory
DATA_DIR=../docs/data

# Server settings
HOST=0.0.0.0
PORT=8000

# Google Gemini API Configuration (Iteration 2)
# Set your Gemini API Key below
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
